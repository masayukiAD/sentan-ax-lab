# === LP制作プロジェクト用 .gitignore（石川さん標準） ===
# 内部資料が公開リポジトリに混入しないようにするためのテンプレ。

# --- 内部資料系 ---
docs/
notes/
internal/
_drafts/
_private/

# --- 環境変数・シークレット ---
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# --- 依存・ビルド成果物 ---
node_modules/
.astro/
.next/
dist/
build/
.output/
.vercel/
.netlify/

# --- ログ・キャッシュ ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.cache/
.turbo/

# --- OS・エディタ ---
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp

# --- 画像生成の中間物 ---
docs/06-images/
*-candidates/
_image-drafts/
